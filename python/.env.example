# Required provider switch. Missing/invalid fails closed.
AI_USE_REMOTE_API=true

# Remote API configuration. Used only when AI_USE_REMOTE_API=true.
OPENAI_BASE_URL=
OPENAI_API_KEY=
AI_GATE_MODEL=gpt-5.4-mini
AI_GATE_FALLBACK_MODELS=gpt-5.4-nano
AI_GATE_REASONING_EFFORT=high
AI_OPENAI_TIMEOUT_SEC=180

# Local OpenAI-compatible server. Used only when AI_USE_REMOTE_API=false,
# or as a non-authoritative research shadow when explicitly enabled.
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_API_KEY=local
LOCAL_AI_MODEL=qwen3.5-9b
LOCAL_AI_ANALYST_MODEL=qwen3.5-9b
LOCAL_AI_CRITIC_MODEL=qwen3.5-9b
LOCAL_AI_ADJUDICATOR_MODEL=qwen3.5-9b
LOCAL_AI_FALLBACK_MODELS=
LOCAL_AI_MODEL_PATH=
LOCAL_AI_HEALTHCHECK_PATH=/models
LOCAL_AI_TIMEOUT_SEC=180
LOCAL_AI_MAX_RETRIES=1
LOCAL_AI_MAX_OUTPUT_TOKENS=4096
LOCAL_AI_TEMPERATURE=0.15
LOCAL_AI_TOP_P=0.85
LOCAL_AI_SEED=42
LOCAL_AI_ENABLE_THINKING=true
LOCAL_AI_REQUIRE_JSON_SCHEMA=true
LOCAL_AI_PARALLELISM=1
LOCAL_AI_CONTEXT_BUDGET_TOKENS=7000
LOCAL_AI_RETRIEVAL_TOP_K=7
# Non-loopback local endpoints fail closed unless this explicit acknowledgement is true.
LOCAL_AI_ALLOW_NON_LOOPBACK_ACK=false

# Shared provider runtime controls
AI_MAX_OUTPUT_TOKENS=25000
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_COOLDOWN_SEC=60
AI_TRADE_MEMORY_FILE=data/ai_trade_memory.sqlite3
# Research/tester only. Never affects LIVE_FORWARD authority.
AI_SHADOW_COMPARE_PROVIDERS=false
# Diagnostic migration value only; never used as trade authority.
# Legacy alias AI_MIN_CONFIDENCE is still read for existing private .env files.
AI_LEGACY_MIN_SELF_REPORTED_CONFIDENCE_DIAGNOSTIC=0.45

# Prompt caching
AI_PROMPT_CACHE_ENABLE=true
AI_PROMPT_CACHE_KEY=po3_live_gate_v2
AI_PROMPT_CACHE_RETENTION=24h

# Setup-signature decision cache
AI_DECISION_CACHE_ENABLE=true
AI_DECISION_CACHE_TTL_SEC=1800
AI_DECISION_CACHE_FILE=data/ai_decision_cache.jsonl

# Batch API: research/backtest only, never live entry approval
AI_USE_BATCH_API=false
AI_BATCH_ONLY_FOR_BACKTEST=true
AI_BATCH_OUTPUT_DIR=data/ai_batch
AI_BATCH_MAX_PENDING=1000

# Flex processing: disabled for live unless explicitly triple-confirmed
AI_USE_FLEX=false
AI_ALLOW_FLEX_FOR_LIVE=false
AI_FLEX_LIVE_ACK=false
AI_SERVICE_TIER=auto
AI_OPENAI_FLEX_TIMEOUT_SEC=600
AI_FLEX_UNAVAILABLE_RETRY_ENABLE=true
AI_FLEX_UNAVAILABLE_MAX_RETRIES=20
AI_FLEX_UNAVAILABLE_COOLDOWN_SEC=30

# Live safety
AI_REQUIRE_RUNTIME_INPUTS_LIVE=true
AI_REJECT_ON_MISSING_RUNTIME_INPUTS_LIVE=true
AI_HARD_PRE_GATE_BEFORE_OPENAI=true
AI_LOG_SKIPPED_CALLS=true
AI_LIVE_FAIL_CLOSED_ON_FAILURE=true
AI_ALLOW_RULE_ONLY_FALLBACK=false
AI_ALLOW_RULE_ONLY_LIVE=false
AI_FALLBACK_RISK_MULTIPLIER=0.0

# MT5 file-bus lifecycle. COMMON_FILES_DIR may be left empty when the standard
# terminal Common/Files location is used.
COMMON_FILES_DIR=
AI_GATE_WORKERS=4
AI_REQUEST_LOCK_STALE_SEC=1800
AI_REQUEST_STABLE_MS=120
AI_RESPONSE_ENCODING=utf-16

# Snapshots remain disabled unless explicitly enabled
AI_ENABLE_SNAPSHOTS=false

# Cost reporting
AI_COST_REPORT_ENABLE=true
AI_COST_REPORT_FILE=logs/ai_cost_report.jsonl

# Live outcome priors fed into the trade-gate prompt
AI_LIVE_BUCKET_PRIORS_FILE=data/live_bucket_priors.json
AI_REQUIRE_LIVE_BUCKET_PRIORS=false
AI_LIVE_BUCKET_PRIORS_MAX_AGE_DAYS=30

# Immutable request/response decision fingerprints
AI_REQUEST_RESPONSE_FINGERPRINT_FILE=logs/ai_request_response_fingerprints.jsonl

# Live-forward authority requires an exact REPEATABLE group when enabled.
AI_REQUIRE_REPEATABILITY_LIVE=true

# Shadow repeatability research. Repeats never trade and bypass decision cache.
AI_SHADOW_REPEAT_ENABLE=false
AI_SHADOW_REPEAT_SAMPLE_RATE=0.02
AI_SHADOW_REPEAT_COUNT=3
AI_SHADOW_REPEAT_MIN_EVALUATED_CANDIDATES=30
AI_SHADOW_REPEAT_MAX_SCORE_STDDEV=0.75
AI_SHADOW_REPEAT_MIN_DECISION_AGREEMENT=0.90
AI_SHADOW_REPEAT_MIN_CHOSEN_CANDIDATE_AGREEMENT=0.90
AI_SHADOW_REPEAT_MIN_VETO_AGREEMENT=0.90
AI_SHADOW_REPEAT_MIN_TARGET_CHOICE_AGREEMENT=0.85
AI_SHADOW_REPEAT_ARTIFACT_FILE=data/ai_repeatability_artifact.json
