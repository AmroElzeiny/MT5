# Harness-only env. Local deterministic provider; NO production API key.
# Select with: $env:PO3_DOTENV_FILE = ".env.harness"
AI_GATE_MODEL=gpt-5.4-nano
AI_GATE_FALLBACK_MODELS=gpt-5.4-nano
AI_GATE_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=25000
AI_GATE_WORKERS=1
AI_ALLOW_RULE_ONLY_FALLBACK=false
AI_ALLOW_RULE_ONLY_LIVE=false
AI_LIVE_FAIL_CLOSED_ON_FAILURE=true
EXPECTANCY_AI_AUDIT_ENABLE=false
EXPECTANCY_AI_MODEL=gpt-5.4-nano
EXPECTANCY_AI_REASONING_EFFORT=low
EXPECTANCY_AI_DECISION_WEIGHT=0.75
EXPECTANCY_AI_MAX_OUTPUT_TOKENS=6000
EXPECTANCY_AI_MIN_VALID_TRADES=100
EXPECTANCY_AI_AUDIT_MIN_NEW_TRADES=400
EXPECTANCY_AI_AUDIT_MAX_AGE_HOURS=0
PO3_VIRTUAL_START_BALANCE=100000
ANALYTICS_AUTO_ACTIVATE=false
POLICY_SHADOW_MODE=false
EXPECTANCY_MIN_TRADES_BEFORE_ACTION=400
EXPECTANCY_FIRST_ACTION_MIN_TRADES=100
EXPECTANCY_MIN_BUCKET_TRADES_BEFORE_ACTION=50
EXPECTANCY_SESSION_WEEKDAY_MIN_TRADES=100
EXPECTANCY_SESSION_WEEKDAY_STRONG_TRADES=100
EXPECTANCY_SESSION_WEEKDAY_UPGRADE_TRADES=100
POLICY_MAX_STEP_FRACTION=0.05
POLICY_MIN_TOTAL_CLOSED_TRADES=400
POLICY_MIN_BUCKET_TRADES=50
POLICY_MIN_PROFIT_FACTOR_AFTER_COSTS=1.15
POLICY_MAX_TRAIN_TEST_GAP_R=0.25
POLICY_MIN_POSITIVE_FOLD_RATE=0.60
POLICY_MAX_DRAWDOWN_R=10.0
PO3_DASHBOARD_TITLE=PO3 Codex Virtual Ledger
PO3_DASHBOARD_OUTPUT=dashboard.html
AI_PROMPT_CACHE_ENABLE=true
AI_PROMPT_CACHE_KEY=po3_live_gate_v2
AI_PROMPT_CACHE_RETENTION=24h
AI_DECISION_CACHE_ENABLE=true
AI_DECISION_CACHE_TTL_SEC=1800
AI_DECISION_CACHE_FILE=data/ai_decision_cache.jsonl
AI_USE_BATCH_API=false
AI_BATCH_ONLY_FOR_BACKTEST=false
AI_BATCH_OUTPUT_DIR=data/ai_batch
AI_BATCH_MAX_PENDING=1000
AI_USE_FLEX=false
AI_ALLOW_FLEX_FOR_LIVE=true
AI_FLEX_LIVE_ACK=true
AI_SERVICE_TIER=flex
AI_OPENAI_TIMEOUT_SEC=60
AI_OPENAI_FLEX_TIMEOUT_SEC=90
AI_FLEX_UNAVAILABLE_RETRY_ENABLE=true
AI_FLEX_UNAVAILABLE_MAX_RETRIES=3
AI_FLEX_UNAVAILABLE_COOLDOWN_SEC=10
AI_REQUIRE_RUNTIME_INPUTS_LIVE=true
AI_REJECT_ON_MISSING_RUNTIME_INPUTS_LIVE=true
AI_HARD_PRE_GATE_BEFORE_OPENAI=true
AI_LOG_SKIPPED_CALLS=true
AI_ENABLE_SNAPSHOTS=false
AI_COST_REPORT_ENABLE=true
AI_COST_REPORT_FILE=logs/ai_cost_report.jsonl
AI_USE_REMOTE_API=false
LOCAL_AI_BASE_URL=http://127.0.0.1:8099/v1
LOCAL_AI_API_KEY=harness
LOCAL_AI_MODEL=harness-deterministic-v1
LOCAL_AI_ANALYST_MODEL=harness-deterministic-v1
LOCAL_AI_CRITIC_MODEL=harness-deterministic-v1
LOCAL_AI_ADJUDICATOR_MODEL=harness-deterministic-v1
LOCAL_AI_FALLBACK_MODELS=
LOCAL_AI_MODEL_PATH=
LOCAL_AI_HEALTHCHECK_PATH=/models
LOCAL_AI_TIMEOUT_SEC=60
LOCAL_AI_MAX_RETRIES=1
LOCAL_AI_MAX_OUTPUT_TOKENS=32768
LOCAL_AI_TEMPERATURE=0
LOCAL_AI_TOP_P=0.85
LOCAL_AI_SEED=42
LOCAL_AI_ENABLE_THINKING=false
LOCAL_AI_REQUIRE_JSON_SCHEMA=true
LOCAL_AI_PARALLELISM=1
LOCAL_AI_CONTEXT_BUDGET_TOKENS=131072
LOCAL_AI_RETRIEVAL_TOP_K=7
LOCAL_AI_ALLOW_NON_LOOPBACK_ACK=false
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_COOLDOWN_SEC=60
AI_TRADE_MEMORY_FILE=data/ai_trade_memory.sqlite3
AI_SHADOW_COMPARE_PROVIDERS=false
AI_LEGACY_MIN_SELF_REPORTED_CONFIDENCE_DIAGNOSTIC=0.45
AI_LIVE_BUCKET_PRIORS_FILE=data/live_bucket_priors.json
AI_REQUIRE_LIVE_BUCKET_PRIORS=false
AI_LIVE_BUCKET_PRIORS_MAX_AGE_DAYS=30
AI_REQUEST_RESPONSE_FINGERPRINT_FILE=logs/ai_request_response_fingerprints.jsonl
AI_REQUIRE_REPEATABILITY_LIVE=true
AI_SHADOW_REPEAT_ENABLE=true
AI_SHADOW_REPEAT_SAMPLE_RATE=0.02
AI_SHADOW_REPEAT_COUNT=3
AI_SHADOW_REPEAT_MIN_EVALUATED_CANDIDATES=30
AI_SHADOW_REPEAT_MAX_SCORE_STDDEV=0.75
AI_SHADOW_REPEAT_MIN_DECISION_AGREEMENT=0.90
AI_SHADOW_REPEAT_MIN_CHOSEN_CANDIDATE_AGREEMENT=0.90
AI_SHADOW_REPEAT_MIN_VETO_AGREEMENT=0.90
AI_SHADOW_REPEAT_MIN_TARGET_CHOICE_AGREEMENT=0.85
AI_SHADOW_REPEAT_ARTIFACT_FILE=data/ai_repeatability_artifact.json
