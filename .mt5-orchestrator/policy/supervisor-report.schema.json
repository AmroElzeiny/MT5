{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "front_end",
    "tier",
    "mode",
    "status",
    "baseline",
    "models",
    "requirements",
    "work_packages",
    "changed_files",
    "tests",
    "test_integrity",
    "diff_audit",
    "reviews",
    "budget",
    "live_action_audit",
    "uncertainties",
    "final_verdict"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "front_end": {
      "enum": [
        "Claude",
        "Codex"
      ]
    },
    "tier": {
      "enum": [
        "Standard",
        "Deep"
      ]
    },
    "mode": {
      "enum": [
        "Offline",
        "Demo"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "escalated",
        "blocked"
      ]
    },
    "baseline": {
      "type": "object"
    },
    "models": {
      "type": "array",
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1
    },
    "work_packages": {
      "type": "array",
      "minItems": 1
    },
    "changed_files": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "test_integrity": {
      "type": "object"
    },
    "diff_audit": {
      "type": "object"
    },
    "reviews": {
      "type": "array",
      "minItems": 1
    },
    "budget": {
      "type": "object"
    },
    "live_action_audit": {
      "type": "array"
    },
    "uncertainties": {
      "type": "array"
    },
    "final_verdict": {
      "enum": [
        "COMPLETE_VERIFIED",
        "COMPLETE_WITH_EXPLICIT_UNVERIFIED_ITEM",
        "ESCALATE_TO_FRONTEND",
        "BLOCKED"
      ]
    }
  }
}